---
import { getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entry = await getEntry("docs", "how-it-works");
if (!entry) throw new Error("Missing docs entry: how-it-works");
const { Content, headings } = await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} lang="en">
  <Content />
</DocsLayout>

<script>
  // Step-through diagram drawn by plugins/rehype-hop-stepper.mjs.
  import "../../scripts/hop-stepper";
</script>
