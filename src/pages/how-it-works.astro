---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { getLocalizedDocEntry } from "../lib/docEntry";

const { entry, untranslated } = await getLocalizedDocEntry("how-it-works", "es");
const { Content, headings } = await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} lang="es" untranslated={untranslated}>
  <Content />
</DocsLayout>

<script>
  // Step-through diagram drawn by plugins/rehype-hop-stepper.mjs.
  import "../scripts/hop-stepper";
</script>
