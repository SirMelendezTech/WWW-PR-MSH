---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import LatestVersions from "../../components/LatestVersions.astro";
import { getLocalizedDocEntry } from "../../lib/docEntry";

const { entry, untranslated } = await getLocalizedDocEntry("hardware", "es");
const { Content, headings } = await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} lang="es" untranslated={untranslated}>
  <LatestVersions lang="es" />
  <Content />
</DocsLayout>
