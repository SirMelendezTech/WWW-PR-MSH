---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import type { Locale } from "../lib/i18n";
import { localizePath } from "../lib/i18n";
import { useStrings } from "../lib/ui-strings";

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description: string;
  headings: Heading[];
  lang?: Locale;
  /** true when this page is showing English content under an /es/ URL because no translation exists yet */
  untranslated?: boolean;
}
const { title, description, headings, lang = "en", untranslated = false } = Astro.props;
const t = useStrings(lang);

const docsNavBase = [
  { label: { en: "Getting Started", es: "Primeros Pasos" }, href: "/getting-started/" },
  { label: { en: "Recommended Hardware", es: "Hardware Recomendado" }, href: "/hardware/" },
  { label: { en: "Recommended Settings", es: "Configuración Recomendada" }, href: "/settings/" },
  { label: { en: "How Meshtastic Works", es: "Cómo Funciona Meshtastic" }, href: "/how-it-works/" },
  { label: { en: "Puerto Rico Mesh", es: "Malla Puerto Rico" }, href: "/pr-mesh/" },
];
const docsNav = docsNavBase.map((item) => ({
  label: item.label[lang],
  href: localizePath(item.href, lang),
}));
const path = Astro.url.pathname;
const toc = headings.filter((h) => h.depth === 2);

// The five docs pages are a reading order, not a menu. Find where this page
// sits so the sidebar can number it and the footer can point to the next step.
const currentIndex = docsNav.findIndex((item) => path.startsWith(item.href));
const prev = currentIndex > 0 ? docsNav[currentIndex - 1] : null;
const next =
  currentIndex >= 0 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : null;
---
<BaseLayout title={title} description={description} lang={lang}>
  <div class="container docs-shell">
    <aside class="docs-sidebar">
      <p class="docs-sidebar-label">{t.docs.readingOrder}</p>
      <nav aria-label={t.docs.docsPagesAria}>
        <ol>
          {docsNav.map((item, i) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                <span class="doc-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="doc-label">{item.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <article class="docs-article">
      <Breadcrumbs lang={lang} items={[{ label: t.docs.sidebarLabel, href: docsNav[0].href }, { label: title }]} />
      <h1>{title}</h1>
      <p class="docs-lede">{description}</p>
      {untranslated && (
        <div class="callout">
          <span class="callout-label">{t.docs.untranslatedLabel}</span>
          {t.docs.untranslatedBody}
        </div>
      )}
      <div class="prose">
        <slot />
      </div>

      {(prev || next) && (
        <nav class="docs-pager" aria-label={t.docs.pagerAria}>
          {prev ? (
            <a class="pager-link pager-prev" href={prev.href}>
              <span class="pager-dir">{t.docs.prevLabel}</span>
              <span class="pager-title">{prev.label}</span>
            </a>
          ) : <span />}
          {next && (
            <a class="pager-link pager-next" href={next.href}>
              <span class="pager-dir">{t.docs.nextLabel}</span>
              <span class="pager-title">{next.label}</span>
            </a>
          )}
        </nav>
      )}
    </article>

    {toc.length > 0 && (
      <aside class="docs-toc">
        <p class="docs-sidebar-label">{t.docs.onThisPage}</p>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    gap: 2.5rem;
    padding-block: 2rem 5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 960px) {
    .docs-shell { grid-template-columns: 220px minmax(0, 1fr) 200px; align-items: start; }
  }

  .docs-sidebar, .docs-toc {
    position: static;
    font-size: 0.88rem;
  }
  @media (min-width: 960px) {
    .docs-sidebar, .docs-toc { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  .docs-sidebar-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin: 0 0 0.75rem;
  }
  .docs-sidebar ol, .docs-toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .docs-sidebar a {
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink-soft);
  }
  .doc-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }
  .docs-sidebar a:hover { color: var(--ink); background: var(--bg-sunken); }
  .docs-sidebar a:hover .doc-num { color: var(--ink-soft); }
  .docs-sidebar a[aria-current="page"] { color: var(--ink); font-weight: 600; background: var(--bg-sunken); }
  .docs-sidebar a[aria-current="page"] .doc-num { color: var(--accent); }

  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
  }
  .pager-link:hover { border-color: var(--secondary); }
  .pager-next { text-align: right; }
  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-faint);
  }
  .pager-link:hover .pager-dir { color: var(--secondary); }
  .pager-title { font-family: var(--font-display); font-weight: 600; color: var(--ink); font-size: 0.95rem; }
  @media (max-width: 560px) {
    .docs-pager { grid-template-columns: 1fr; }
    .pager-next { text-align: left; }
  }

  .docs-toc a { display: block; padding: 0.3rem 0; text-decoration: none; color: var(--ink-faint); border-left: 2px solid var(--border); padding-left: 0.75rem; }
  .docs-toc a:hover { color: var(--secondary); border-left-color: var(--secondary); }

  .docs-article { min-width: 0; }
  .docs-lede { font-size: 1.1rem; color: var(--ink-soft); max-width: 62ch; margin-top: 0.75rem; }

  .prose { max-width: 72ch; margin-top: 2rem; }
  .prose :global(h2) { margin-top: 2.2em; padding-top: 0.2em; scroll-margin-top: calc(var(--header-h) + 16px); }
  .prose :global(h2):first-child { margin-top: 0; }
  .prose :global(h3) { scroll-margin-top: calc(var(--header-h) + 16px); margin-top: 1.6em; }
  .prose :global(ul), .prose :global(ol) { color: var(--ink-soft); padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(.table-wrap),
  .prose :global(table) { max-width: 100%; }
</style>
