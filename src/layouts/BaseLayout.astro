---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { useStrings } from "../lib/ui-strings";
import { localizePath, defaultLocale, type Locale } from "../lib/i18n";
import { DISCORD_INVITE_URL, FACEBOOK_GROUP_URL, REDDIT_PR_URL } from "../lib/community";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
  lang?: Locale;
  image?: string;
  /**
   * Counterpart URL in the other locale.
   * - omitted: this page exists in both locales at mirrored paths (auto path-swap)
   * - string: explicit counterpart URL
   * - null: no counterpart exists (no hreflang alternate emitted)
   */
  altLocaleHref?: string | null;
  /** "article" for blog posts; everything else is a "website" page. */
  ogType?: "website" | "article";
  /** Blog posts only: emitted as article:published_time. */
  publishedTime?: Date;
  /** Extra schema.org objects for this page, merged into the JSON-LD graph. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, noIndex = false, lang = "es", image = "/og-default.png", ogType = "website", publishedTime, jsonLd = [] } = Astro.props;
const altLocaleHref = "altLocaleHref" in Astro.props ? Astro.props.altLocaleHref ?? null : undefined;
const t = useStrings(lang);
const siteTitle = title === t.home.title ? title : `${title} | PRMSH`;
const site = Astro.site ?? new URL("https://meshtastic.prmsh.com");
const selfPath = Astro.url.pathname;
const canonical = new URL(selfPath, site).toString();
const ogImage = new URL(image, site).toString();

// hreflang alternates: skip on noindex pages and where no counterpart exists.
const otherLocale: Locale = lang === "en" ? "es" : "en";
const counterpartPath =
  altLocaleHref === undefined ? localizePath(selfPath, otherLocale) : altLocaleHref;
const showAlternates = !noIndex && counterpartPath !== null;
const enPath = lang === "en" ? selfPath : counterpartPath;
const esPath = lang === "es" ? selfPath : counterpartPath;
const absUrl = (p: string) => new URL(p, site).toString();
// x-default is the Spanish (unprefixed) URL: Spanish is the site's default locale.
const defaultPath = defaultLocale === "es" ? esPath : enPath;

// schema.org graph. The Organization and WebSite nodes go on every page so
// other nodes (articles, breadcrumbs) can reference them by @id.
const orgId = absUrl("/#organization");
const websiteId = absUrl("/#website");
const graph = noIndex
  ? []
  : [
      {
        "@type": "Organization",
        "@id": orgId,
        name: "PRMSH",
        alternateName: lang === "es" ? "Comunidad Meshtastic de Puerto Rico" : "Puerto Rico Meshtastic Community",
        url: absUrl("/"),
        logo: absUrl("/favicon.svg"),
        areaServed: { "@type": "Place", name: "Puerto Rico" },
        sameAs: [DISCORD_INVITE_URL, FACEBOOK_GROUP_URL, REDDIT_PR_URL],
      },
      {
        "@type": "WebSite",
        "@id": websiteId,
        name: "PRMSH",
        url: absUrl("/"),
        inLanguage: ["es-PR", "en-US"],
        publisher: { "@id": orgId },
      },
      {
        "@type": "WebPage",
        "@id": `${canonical}#webpage`,
        url: canonical,
        name: siteTitle,
        description,
        inLanguage: lang === "es" ? "es-PR" : "en-US",
        isPartOf: { "@id": websiteId },
      },
      ...jsonLd,
    ];
// Escape "<" so no string value can close the <script> element early.
const jsonLdText = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noIndex && <meta name="robots" content="noindex" />}

  {showAlternates && (
    <>
      <link rel="alternate" hreflang="en" href={absUrl(enPath as string)} />
      <link rel="alternate" hreflang="es" href={absUrl(esPath as string)} />
      <link rel="alternate" hreflang="x-default" href={absUrl(defaultPath as string)} />
    </>
  )}

  <meta property="og:type" content={ogType} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="PRMSH" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === "es" ? "es_PR" : "en_US"} />
  {showAlternates && <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_PR"} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {graph.length > 0 && <script type="application/ld+json" set:html={jsonLdText} />}

  {/* Ackee: self-hosted, cookieless page-view analytics. Production builds
       only, so `astro dev` never counts as a visit. `detailed` also records
       OS, device, browser, screen size and language. */}
  {import.meta.env.PROD && (
    <script
      is:inline
      async
      src="https://meshcore-ackee-7307a6-196-12-191-109.sslip.io/tracker.js"
      data-ackee-server="https://meshcore-ackee-7307a6-196-12-191-109.sslip.io"
      data-ackee-domain-id="fc31ac98-ac0b-4690-870c-08f434d66d3d"
      data-ackee-opts='{"detailed":true}'
    ></script>
  )}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0b3d78" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <script is:inline>
    (function () {
      try {
        const stored = localStorage.getItem("meshpr-theme");
        if (stored) document.documentElement.setAttribute("data-theme", stored);
      } catch (e) {}
    })();
  </script>

</head>
<body
  data-i18n-copy={t.copyButton.copy}
  data-i18n-copied={t.copyButton.copied}
  data-i18n-copy-fallback={t.copyButton.fallback}
  data-i18n-copy-aria={t.copyButton.aria}
>
  <a href="#main" class="skip-link">{t.skipLink}</a>
  <Header altLocaleHref={altLocaleHref} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <SearchDialog lang={lang} />

  <script>
    const COPY = document.body.dataset.i18nCopy || "Copy";
    const COPIED = document.body.dataset.i18nCopied || "Copied";
    const COPY_FALLBACK = document.body.dataset.i18nCopyFallback || "Press Ctrl+C";
    const COPY_ARIA = document.body.dataset.i18nCopyAria || "Copy command to clipboard";

    function wireCopyButtons(root: ParentNode = document) {
      root.querySelectorAll("pre:not([data-copy-wired])").forEach((pre) => {
        pre.setAttribute("data-copy-wired", "true");
        const code = pre.querySelector("code");
        if (!code) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.textContent = COPY;
        btn.setAttribute("aria-label", COPY_ARIA);
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(code.textContent || "");
            btn.textContent = COPIED;
            btn.dataset.copied = "true";
            setTimeout(() => { btn.textContent = COPY; btn.dataset.copied = "false"; }, 1800);
          } catch {
            btn.textContent = COPY_FALLBACK;
          }
        });
        pre.appendChild(btn);
      });
    }
    wireCopyButtons();
    document.addEventListener("astro:page-load", () => wireCopyButtons());
  </script>
</body>
</html>
