---
import type { MeshNode } from "../lib/nodes";
import type { Locale } from "../lib/i18n";
import { localizePath } from "../lib/i18n";
import { useStrings } from "../lib/ui-strings";
import frame from "../data/map-frame.json";
import terrain from "../data/terrain.json";
import coast from "../data/coast.json";

interface Props {
  nodes: MeshNode[];
  live: boolean;
  lang?: Locale;
}
const { nodes, live, lang = "es" } = Astro.props;
const m = useStrings(lang).mapPreview;

// Frame: the main island, Vieques, and St. Thomas — the eastern end of what
// this mesh actually reaches. Mona and St. Croix are left out; both would cost
// a fifth of the width for water no node reports from. The constants live in
// src/data/map-frame.json because scripts/terrain.mjs projects the relief
// with the same numbers.
const { lon0: LON0, lon1: LON1, lat0: LAT0, lat1: LAT1, vw: VW, vh: VH } = frame;

// Coastlines from Natural Earth 1:10m (public domain): the main island,
// Vieques, Culebra and St. Thomas, projected once with the
// constants above and simplified to ~0.5 viewBox units (about 140 m of
// shoreline). Regenerate these together with the constants or the nodes
// drift off the coast.
const COAST = coast.paths;

const inFrame = (n: MeshNode) =>
  n.lng >= LON0 && n.lng <= LON1 && n.lat >= LAT0 && n.lat <= LAT1;

// Offline first so the live ones sit on top where markers pile up in the metro.
const plotted = nodes
  .filter(inFrame)
  .map((n) => ({
    ...n,
    x: ((n.lng - LON0) / (LON1 - LON0)) * VW,
    y: ((LAT1 - n.lat) / (LAT1 - LAT0)) * VH,
  }))
  .sort((a, b) => Number(a.status === "online") - Number(b.status === "online"));

// The stat describes the whole network, the same count the footer shows;
// a node or two outside the frame (Mona, St. Croix) still counts.
const onlineCount = nodes.filter((n) => n.status === "online").length;
const plottedOnline = plotted.filter((n) => n.status === "online").length;
const label = live ? m.nodes : m.sampleNodes;
---
<section class="coverage">
  <div class="coverage-head">
    <p class="eyebrow">{m.eyebrow}</p>
    <h2>{m.h2}</h2>
    <p class="coverage-copy">{m.copy}</p>
    {!live && <p class="coverage-note">{m.sampleNote}</p>}
  </div>

  <figure class="coverage-figure">
    <svg
      class="coverage-map"
      viewBox={`0 0 ${VW} ${VH}`}
      role="img"
      aria-label={m.mapAria(plotted.length, plottedOnline)}
    >
      <g class="coast">
        {COAST.map((d) => <path d={d} />)}
      </g>
      <g class="relief" aria-hidden="true">
        {terrain.bands.map((b, i) => <path class={`band band-${i + 1}`} d={b.d} fill-rule="evenodd" />)}
      </g>
      <g class="marks">
        {plotted.map((n, i) => (
          <g class={`mark mark--${n.status}`} style={`--d:${(i % 9) * 0.35}s`}>
            {n.status === "online" && <circle class="mark-pulse" cx={n.x} cy={n.y} r="7" />}
            <circle
              class="mark-dot"
              cx={n.x}
              cy={n.y}
              r={n.status === "online" ? 4 : 3}
              data-name={n.name}
              data-type={n.type}
              data-status={n.status}
              data-last={n.lastSeen}
            />
          </g>
        ))}
      </g>
    </svg>

    <div class="coverage-readout" role="status" aria-live="off" hidden>
      <span class="readout-name"></span>
      <span class="readout-meta"></span>
    </div>

    <p class="coverage-stat">
      <span class="stat-figure">{onlineCount}</span>
      <span class="stat-label">{m.statOnline}</span>
      <span class="stat-sub">{m.statOf} {nodes.length} {label}</span>
    </p>

    <figcaption class="coverage-legend">
      <span class="key key--online">{m.legendOnline}</span>
      <span class="key key--offline">{m.legendOffline}</span>
      <span class="key key--hint">{m.legendHint}</span>
      <span class="key key--credit">{m.reliefCredit}</span>
    </figcaption>
  </figure>

  <a href={localizePath("/map/", lang)} class="btn btn-primary coverage-cta">{m.cta}</a>
</section>

<style>
  /* This block is the one place on the home page where the data draws itself,
     so it carries more weight than the cards around it: flat brand ground, a
     wider radius, the deepest shadow, and the only oversized numeral. */
  .coverage {
    position: relative;
    background: var(--hue-blue);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    color: #fff;
    padding: 2rem 1.5rem 1.75rem;
    overflow: hidden;
  }
  @media (min-width: 780px) {
    .coverage { padding: 2.5rem 2.5rem 2rem; }
  }

  .coverage-head { max-width: 46ch; }
  .coverage-head .eyebrow { color: var(--hue-turquoise-bright); }
  .coverage-head h2 { color: #fff; margin: 0.35rem 0 0.7rem; }
  .coverage-copy { color: color-mix(in srgb, #fff 78%, transparent); font-size: 1.02rem; margin: 0; }
  .coverage-note { color: color-mix(in srgb, #fff 60%, transparent); font-size: 0.82rem; margin: 0.6rem 0 0; }

  .coverage-figure { position: relative; margin: 1.75rem 0 0; }
  .coverage-map { display: block; width: 100%; height: auto; }

  .coast path {
    fill: color-mix(in srgb, var(--hue-turquoise) 13%, transparent);
    stroke: color-mix(in srgb, var(--hue-turquoise-bright) 55%, transparent);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  /* Relief: one hue (the card's own white), stepping up in opacity with
     height, so the island reads as plain → karst → Cordillera without adding
     a second colour. The nodes stay the only saturated thing on the map.
     Bands start at 150 m, inside the Natural Earth coastline above. */
  .band {
    fill: #fff;
    stroke: color-mix(in srgb, #fff 26%, transparent);
    stroke-width: 0.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .band-1 { fill-opacity: 0.05; }
  .band-2 { fill-opacity: 0.06; }
  .band-3 { fill-opacity: 0.08; }
  .band-4 { fill-opacity: 0.11; }

  /* At phone width the map is ~80px tall and the desktop steps blur into the
     land fill. Roughly double each step so the Cordillera still reads. */
  @media (max-width: 779px) {
    .band { stroke: color-mix(in srgb, #fff 40%, transparent); }
    .band-1 { fill-opacity: 0.10; }
    .band-2 { fill-opacity: 0.13; }
    .band-3 { fill-opacity: 0.17; }
    .band-4 { fill-opacity: 0.24; }
  }

  /* Hover feedback rides on the stroke, not the radius: `r` as a CSS property
     is still uneven across browsers, and a ring reads at this dot size anyway. */
  .mark-dot {
    stroke: var(--hue-blue);
    stroke-width: 1.2;
    cursor: pointer;
    transition: stroke 0.16s ease, stroke-width 0.16s ease;
  }
  .mark--online .mark-dot { fill: var(--hue-turquoise-bright); }
  .mark--offline .mark-dot { fill: #7c8f97; }
  .mark-dot:hover, .mark-dot.is-active { stroke: #fff; stroke-width: 3; }

  /* Puerto Rico is a 3.7:1 shape, so in a phone-width column the map is only
     about 80px tall and a 4-unit marker lands under a pixel. Scaling each
     circle about its own centre keeps every node on its real coordinate. */
  @media (max-width: 779px) {
    .mark-dot, .mark-pulse {
      transform-box: fill-box;
      transform-origin: center;
    }
    .mark-dot { transform: scale(2.6); }
    .mark-pulse { animation: none; opacity: 0.16; }
  }

  .mark-pulse {
    fill: var(--hue-turquoise-bright);
    opacity: 0.18;
    transform-origin: center;
    transform-box: fill-box;
    animation: mark-pulse 3.6s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes mark-pulse {
    0%, 100% { transform: scale(0.6); opacity: 0.20; }
    50% { transform: scale(1.6); opacity: 0.02; }
  }

  /* Sits on open water south-east of the island — the one corner of the frame
     no node reports from, so the number never covers real data. */
  .coverage-stat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }
  @media (min-width: 780px) {
    .coverage-stat {
      position: absolute;
      right: 0;
      bottom: 0.5rem;
      margin: 0;
      display: grid;
      justify-items: end;
      gap: 0;
      text-align: right;
    }
  }
  .stat-figure {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4.2rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--hue-turquoise-bright);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #fff;
  }
  .stat-sub { font-size: 0.8rem; color: color-mix(in srgb, #fff 62%, transparent); }

  /* `display: grid` would otherwise win over the hidden attribute. */
  .coverage-readout[hidden] { display: none; }
  .coverage-readout {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -132%);
    pointer-events: none;
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, #041526 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--hue-turquoise-bright) 40%, transparent);
    white-space: nowrap;
  }
  .readout-name { font-weight: 600; font-size: 0.84rem; }
  .readout-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: color-mix(in srgb, #fff 65%, transparent);
  }

  .coverage-legend {
    display: flex;
    /* Stops the keys running under the stat that overlaps the map's corner. */
    max-width: 62%;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, #fff 62%, transparent);
  }
  .key { display: inline-flex; align-items: center; gap: 0.45em; }
  .key--credit { text-transform: none; letter-spacing: 0; color: color-mix(in srgb, #fff 45%, transparent); }
  .key--online::before, .key--offline::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .key--online::before { background: var(--hue-turquoise-bright); }
  .key--offline::before { background: #7c8f97; }
  .key--hint { display: none; }
  @media (hover: hover) {
    .key--hint { display: inline-flex; }
  }
  @media (max-width: 779px) {
    .coverage-legend { max-width: none; }
  }

  .coverage-cta {
    margin-top: 1.5rem;
    background: var(--hue-turquoise-bright);
    color: #03101d;
    white-space: nowrap;
  }
  @media (min-width: 780px) {
    .coverage-cta { margin-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark-pulse { animation: none; opacity: 0.14; }
  }
</style>

<script>
  const figure = document.querySelector<HTMLElement>(".coverage-figure");
  const readout = figure?.querySelector<HTMLElement>(".coverage-readout");
  const nameEl = readout?.querySelector<HTMLElement>(".readout-name");
  const metaEl = readout?.querySelector<HTMLElement>(".readout-meta");

  if (figure && readout && nameEl && metaEl) {
    let active: SVGCircleElement | null = null;

    const show = (dot: SVGCircleElement) => {
      const box = figure.getBoundingClientRect();
      const mark = dot.getBoundingClientRect();
      active?.classList.remove("is-active");
      active = dot;
      dot.classList.add("is-active");
      nameEl.textContent = dot.dataset.name || "";
      metaEl.textContent = [dot.dataset.type, dot.dataset.last].filter(Boolean).join(" · ");
      readout.style.left = `${mark.left - box.left + mark.width / 2}px`;
      readout.style.top = `${mark.top - box.top}px`;
      readout.hidden = false;
    };

    const hide = () => {
      active?.classList.remove("is-active");
      active = null;
      readout.hidden = true;
    };

    figure.addEventListener("pointerover", (event) => {
      const dot = (event.target as Element).closest<SVGCircleElement>(".mark-dot");
      if (dot) show(dot);
    });
    figure.addEventListener("pointerleave", hide);
    window.addEventListener("scroll", () => { if (active) hide(); }, { passive: true });
  }
</script>
