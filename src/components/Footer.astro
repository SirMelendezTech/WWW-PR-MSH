---
import MeshMark from "./MeshMark.astro";
import type { Locale } from "../lib/i18n";
import { localizePath } from "../lib/i18n";
import { useStrings } from "../lib/ui-strings";

interface Props { lang?: Locale }
const { lang = "en" } = Astro.props;
const t = useStrings(lang);
const f = t.footer;
const p = (href: string) => localizePath(href, lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={p("/")} class="brand">
        <MeshMark />
        <span class="brand-text">Meshtastic<span class="brand-suffix">PR</span></span>
      </a>
      <p>{f.blurb}</p>
    </div>

    <nav aria-label={f.gettingStartedHeading}>
      <h4>{f.gettingStartedHeading}</h4>
      <ul>
        <li><a href={p("/getting-started/")}>{f.gettingStarted}</a></li>
        <li><a href={p("/hardware/")}>{f.recommendedHardware}</a></li>
        <li><a href={p("/settings/")}>{f.recommendedSettings}</a></li>
      </ul>
    </nav>

    <nav aria-label={f.documentationHeading}>
      <h4>{f.documentationHeading}</h4>
      <ul>
        <li><a href={p("/how-it-works/")}>{f.howItWorks}</a></li>
        <li><a href={p("/pr-mesh/")}>{f.prMesh}</a></li>
        <li><a href={p("/map/")}>{f.nodeMap}</a></li>
        <li><a href={p("/blog/")}>{f.blog}</a></li>
      </ul>
    </nav>

    <nav aria-label={f.communityHeading}>
      <h4>{f.communityHeading}</h4>
      <ul>
        <li><a href={p("/community/")}>{f.communityHub}</a></li>
        <li><a href={`${p("/community/")}#contribute`}>{f.howToContribute}</a></li>
        <li><a href={`${p("/community/")}#events`}>{f.events}</a></li>
      </ul>
    </nav>

    <nav aria-label={f.linksHeading}>
      <h4>{f.linksHeading}</h4>
      <ul>
        <li><a href={p("/links/")}>{f.linksResources}</a></li>
        <li><a href="https://meshtastic.org" target="_blank" rel="noopener">Meshtastic.org<span class="sr-only"> {t.opensInNewTab}</span></a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>
      {f.copyright(year)}{" "}
      <span class="footer-license">{f.licenseBefore}<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">{f.licenseName}</a>{f.licenseAfter}</span>
    </p>
    <p class="disclaimer">{f.disclaimer}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
    margin-top: 5rem;
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer-grid { grid-template-columns: 1.6fr repeat(4, 1fr); }
  }
  .footer-brand .brand { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; margin-bottom: 0.8rem; }
  .footer-brand .brand-text { font-family: var(--font-display); font-weight: 700; color: var(--ink); }
  .footer-brand .brand-suffix { color: var(--accent); margin-left: 0.3em; font-size: 0.72em; vertical-align: super; }
  .footer-brand p { max-width: 32ch; font-size: 0.92rem; }

  .site-footer h4 { font-size: 0.78rem; margin-bottom: 0.9rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .site-footer a { color: var(--ink-soft); text-decoration: none; font-size: 0.92rem; }
  .site-footer a:hover { color: var(--secondary); }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-block: 1.4rem 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .footer-bottom p { margin: 0; color: inherit; }
  .footer-license { color: var(--ink-faint); }
  .footer-license a { color: inherit; text-decoration: underline; }
  .footer-license a:hover { color: var(--secondary); }
  .disclaimer { max-width: 60ch; }
</style>
