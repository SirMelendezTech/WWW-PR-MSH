---
import Breadcrumbs from "../Breadcrumbs.astro";
import type { Locale } from "../../lib/i18n";
import { useStrings } from "../../lib/ui-strings";

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = useStrings(lang).links;

const official = [
  { name: "Meshtastic Puerto Rico Network Monitor", url: "https://monitor.prmsh.com/", note: l.notes.monitor },
  { name: "PalmasMesh", url: "https://palmasmesh.com/", note: l.notes.palmasmesh },
  { name: "Malla PR", url: "https://malla.prmsh.com/map", note: l.notes.mallapr },
  { name: "MeshView PR", url: "https://meshview.prmsh.com/", note: l.notes.meshview },
];

const project = [
  { name: "Meshtastic.org", url: "https://meshtastic.org", note: l.notes.meshtasticOrg },
  { name: "Meshtastic Web Flasher", url: "https://flasher.meshtastic.org/", note: l.notes.flasher },
  { name: "Meshtastic hardware list", url: "https://meshtastic.org/docs/hardware/devices/", note: l.notes.hwList },
  { name: "Meshtastic CLI reference", url: "https://meshtastic.org/docs/software/python/cli/", note: l.notes.cli },
  { name: "Meshtastic Antenna Reports", url: "https://github.com/meshtastic/antenna-reports", note: l.notes.antennaReports },
  { name: "Awesome Meshtastic — Hardware & Sensors", url: "https://github.com/SignalGap/awesome-meshtastic#hardware-and-sensors", note: l.notes.awesomeHw },
  { name: "Awesome Meshtastic — Server Software", url: "https://github.com/ShakataGaNai/awesome-meshtastic#server-software", note: l.notes.awesomeServer },
  { name: "Malla", url: "https://github.com/zenitraM/malla", note: l.notes.malla },
];

const reference = [
  { name: "RF Index", url: "https://www.rfindex.com/", note: l.notes.rfindex },
  { name: "Arizona Meshtastic Community — Recommended Settings", url: "https://azmsh.net/docs/recommended-settings.html", note: l.notes.azSettings },
  { name: "Arizona Meshtastic Community — Recommended Hardware", url: "https://azmsh.net/docs/recommended-hardware.html", note: l.notes.azHardware },
];

const groups = [
  { heading: l.prHeading, items: official },
  { heading: l.projectHeading, items: project },
  { heading: l.referenceHeading, items: reference },
];

const host = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ""); } catch { return ""; }
};
---
<div class="container page-head">
  <Breadcrumbs lang={lang} items={[{ label: l.crumb }]} />
  <p class="eyebrow">{l.eyebrow}</p>
  <h1>{l.h1}</h1>
  <p class="page-lede">{l.lede}</p>
</div>

<div class="container links-sections">
  {groups.map((group, gi) => (
    <section class="link-group">
      <p class="group-mark">
        <span class="group-num" aria-hidden="true">{String(gi + 1).padStart(2, "0")}</span>
        <span>{group.heading}</span>
      </p>
      <ul class="link-list">
        {group.items.map((item) => (
          <li>
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.name}<span class="ext-arrow" aria-hidden="true">↗</span><span class="sr-only">{l.externalBadgeSr}</span>
            </a>
            <span class="link-host">{host(item.url)}</span>
            <p>{item.note}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .page-head { padding-block: 2.5rem 1rem; max-width: 68ch; }
  .page-lede { font-size: 1.05rem; margin-top: 0.5rem; }

  .links-sections { padding-block: 2rem 5rem; display: grid; gap: 0; }

  .link-group { display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  @media (min-width: 820px) {
    .link-group { grid-template-columns: 12rem minmax(0, 1fr); gap: 0 2.5rem; align-items: start; }
  }
  .link-group + .link-group { margin-top: 1rem; }

  .group-mark {
    display: flex;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-soft);
    margin: 0;
    padding-top: 1.6rem;
  }
  .group-num { color: var(--accent); font-weight: 700; }
  @media (min-width: 820px) {
    .group-mark { position: sticky; top: calc(var(--header-h) + 20px); }
  }

  .link-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .link-list li {
    border-top: 1px solid var(--border);
    padding: 1.4rem 0 1.5rem;
  }
  .link-list a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
  .link-list a:hover { color: var(--secondary); text-decoration: underline; text-underline-offset: 3px; }
  .ext-arrow { margin-left: 0.3em; color: var(--ink-faint); font-weight: 400; }
  .link-list a:hover .ext-arrow { color: var(--secondary); }

  .link-host {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }
  .link-list p { margin: 0.55rem 0 0; font-size: 0.9rem; max-width: 56ch; color: var(--ink-soft); }
</style>
