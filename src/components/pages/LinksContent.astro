---
import Breadcrumbs from "../Breadcrumbs.astro";
import type { Locale } from "../../lib/i18n";
import { useStrings } from "../../lib/ui-strings";
import {
  DISCORD_INVITE_URL,
  FACEBOOK_GROUP_URL,
  REDDIT_PR_URL,
  REDDIT_GLOBAL_URL,
  SKYNET_URL,
  MESHCORE_PR_URL,
  NODE_GUIDES_URL,
} from "../../lib/community";

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = useStrings(lang).links;

// Groups are named for what a visitor wants to do, not for who owns the link.
// Whether a link is official goes in its note, where it matters. Names and
// notes are keyed into ui-strings so /links/ is fully Spanish.
const groups: { id: string; heading: string; items: { key: string; url: string }[] }[] = [
  {
    id: "network",
    heading: l.groups.network,
    items: [
      { key: "monitor", url: "https://monitor.prmsh.com/" },
      { key: "mallapr", url: "https://malla.prmsh.com/map" },
      { key: "meshview", url: "https://meshview.prmsh.com/" },
    ],
  },
  {
    id: "talk",
    heading: l.groups.talk,
    items: [
      { key: "discord", url: DISCORD_INVITE_URL },
      { key: "facebookGroup", url: FACEBOOK_GROUP_URL },
      { key: "redditPR", url: REDDIT_PR_URL },
    ],
  },
  {
    id: "projects",
    heading: l.groups.projects,
    items: [
      { key: "palmasmesh", url: "https://palmasmesh.com/" },
      { key: "skynet", url: SKYNET_URL },
      { key: "meshcorePr", url: MESHCORE_PR_URL },
    ],
  },
  {
    id: "setup",
    heading: l.groups.setup,
    items: [
      { key: "nodeGuides", url: NODE_GUIDES_URL },
      { key: "flasher", url: "https://flasher.meshtastic.org/" },
      { key: "hwList", url: "https://meshtastic.org/docs/hardware/devices/" },
      { key: "cli", url: "https://meshtastic.org/docs/software/python/cli/" },
      { key: "azSettings", url: "https://azmsh.net/docs/recommended-settings.html" },
      { key: "azHardware", url: "https://azmsh.net/docs/recommended-hardware.html" },
    ],
  },
  {
    id: "learn",
    heading: l.groups.learn,
    items: [
      { key: "meshtasticOrg", url: "https://meshtastic.org" },
      { key: "antennaReports", url: "https://github.com/meshtastic/antenna-reports" },
      { key: "rfindex", url: "https://www.rfindex.com/" },
    ],
  },
  {
    id: "global",
    heading: l.groups.global,
    items: [
      { key: "redditGlobal", url: REDDIT_GLOBAL_URL },
      { key: "awesomeHw", url: "https://github.com/SignalGap/awesome-meshtastic#hardware-and-sensors" },
      { key: "awesomeServer", url: "https://github.com/ShakataGaNai/awesome-meshtastic#server-software" },
      { key: "malla", url: "https://github.com/zenitraM/malla" },
    ],
  },
];

const host = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ""); } catch { return ""; }
};
---
<div class="container">
  <div class="page-head">
    <Breadcrumbs lang={lang} items={[{ label: l.crumb }]} />
    <h1>{l.h1}</h1>
    <p class="page-lede">{l.lede}</p>
  </div>
</div>

<div class="container link-index">
  {groups.map((group) => (
    <section class="link-group" id={group.id} aria-labelledby={`${group.id}-h`}>
      <h2 id={`${group.id}-h`} class="group-heading">{group.heading}</h2>
      <ul class="link-list">
        {group.items.map((item) => (
          <li class="link-row">
            <a class="link-name" href={item.url} target="_blank" rel="noopener noreferrer">
              {l.names[item.key]}<span class="sr-only">{l.externalBadgeSr}</span>
            </a>
            <p class="link-note">{l.notes[item.key]}</p>
            <span class="link-host">{host(item.url)}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .page-head { padding-block: 2.5rem 1.5rem; max-width: 64ch; }
  .page-lede { font-size: 1.05rem; margin-top: 0.5rem; }

  /* A quiet index: the group name sits in a narrow left rail and each link is
     one ruled line. Nothing here competes for attention; the names do the
     work, so they carry the only weight on the page. */
  .link-index { padding-block: 0.5rem 5rem; }

  .link-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--border-strong);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  @media (min-width: 900px) {
    .link-group { grid-template-columns: 11rem minmax(0, 1fr); gap: 0 2.5rem; }
  }

  .group-heading {
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
    margin: 0.55rem 0 0.25rem;
  }

  .link-list { list-style: none; margin: 0; padding: 0; }

  /* Phone: name and host on one line, note under them.
     Desktop: name, note and host across one line. */
  .link-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name host"
      "note note";
    column-gap: 1rem;
    row-gap: 0.15rem;
    padding-block: 0.6rem;
  }
  .link-row + .link-row { border-top: 1px solid var(--border); }
  @media (min-width: 900px) {
    .link-row {
      grid-template-columns: 15rem minmax(0, 1fr) 10.5rem;
      grid-template-areas: "name note host";
      align-items: baseline;
    }
  }

  .link-name {
    grid-area: name;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
    text-decoration: none;
  }
  .link-name:hover { color: var(--secondary); text-decoration: underline; text-underline-offset: 3px; }

  .link-note {
    grid-area: note;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 64ch;
  }

  /* The host answers "where does this go?" before the click. Small body face,
     right-aligned so the column reads as a margin note, not as data.
     --ink-soft, not --ink-faint: faint is under 4.5:1 on the light theme. */
  .link-host {
    grid-area: host;
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>
