---
import MeshMark from "./MeshMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getLocaleFromPath, localizePath } from "../lib/i18n";
import { useStrings } from "../lib/ui-strings";
import { DISCORD_INVITE_URL } from "../lib/community";

const GITHUB_REPO_URL = "https://github.com/SirMelendezTech/WWW-PR-MSH";

interface Props { altLocaleHref?: string | null }
const { altLocaleHref = null } = Astro.props;

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const otherLocale = locale === "es" ? "en" : "es";
const t = useStrings(locale);

// Language switch target: explicit counterpart if given; otherwise the other
// locale's blog index for blog pages (post slugs don't mirror across locales),
// or a plain path swap everywhere else.
const isBlogPath = /^\/(es\/)?blog(\/|$)/.test(path);
const langSwitchHref = altLocaleHref
  ? altLocaleHref
  : isBlogPath
    ? otherLocale === "es" ? "/es/blog/" : "/blog/"
    : localizePath(path, otherLocale);
const homeHref = locale === "es" ? "/es/" : "/";

// `topBar: false` keeps a page out of the desktop bar only — the menu and the
// footer still list it. The Spanish labels are what set the ceiling: at nine
// entries the bar needs 883px and only 745px fit.
const navItemsBase = [
  { label: t.nav.gettingStarted, href: "/getting-started/" },
  { label: t.nav.hardware, href: "/hardware/" },
  { label: t.nav.settings, href: "/settings/" },
  { label: t.nav.howItWorks, href: "/how-it-works/", topBar: false },
  { label: t.nav.prMesh, href: "/pr-mesh/" },
  { label: t.nav.map, href: "/map/" },
  { label: t.nav.blog, href: "/blog/" },
  { label: t.nav.community, href: "/community/" },
  { label: t.nav.links, href: "/links/", topBar: false },
];

// Every top-level page now has an /es/ route, so localize all nav targets.
const navItems = navItemsBase.map((item) => ({
  label: item.label,
  href: locale === "es" ? `/es${item.href}` : item.href,
  topBar: item.topBar !== false,
}));
const topBarItems = navItems.filter((item) => item.topBar);

function isActive(href: string) {
  if (href === "/" || href === "/es/") return path === href;
  return path.startsWith(href);
}
---
<header class="site-header">
  <div class="container header-row">
    <a href={homeHref} class="brand">
      <MeshMark />
      <span class="brand-text">
        <span class="brand-name">PRMSH</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label={t.nav.primaryNavAria}>
      <ul>
        {topBarItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button id="search-open" class="icon-btn" type="button" aria-label={t.nav.searchAria} aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </button>
      <a
        href={DISCORD_INVITE_URL}
        class="icon-btn header-extra"
        aria-label={t.nav.discordAria}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
      </a>
      <a
        href={GITHUB_REPO_URL || "#"}
        class="icon-btn header-extra"
        aria-label={t.nav.viewSourceAria}
        target={GITHUB_REPO_URL ? "_blank" : undefined}
        rel={GITHUB_REPO_URL ? "noopener noreferrer" : undefined}
      >
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
      <a href={langSwitchHref} data-lang-choice={otherLocale} class="icon-btn lang-switch header-extra" aria-label={otherLocale === "es" ? t.nav.switchToSpanish : t.nav.switchToEnglish}>
        {otherLocale.toUpperCase()}
      </a>
      <ThemeToggle lang={locale} />
      <button id="nav-toggle" class="icon-btn nav-toggle" type="button" aria-label={t.nav.openMenuAria} aria-expanded="false" aria-controls="mobile-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.mobileNavAria} hidden>
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
      ))}
      <li class="mobile-nav-extra">
        <a href={langSwitchHref} data-lang-choice={otherLocale}>
          {otherLocale === "es" ? t.nav.switchToSpanish : t.nav.switchToEnglish}
        </a>
      </li>
      <li class="mobile-nav-extra">
        <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer">{t.nav.discordAria}</a>
      </li>
      {GITHUB_REPO_URL && (
        <li class="mobile-nav-extra">
          <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">{t.nav.viewSourceAria}</a>
        </li>
      )}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .header-row {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  @media (min-width: 1140px) {
    .header-row { gap: 1.5rem; }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    margin-right: auto;
    flex-shrink: 0;
  }
  .brand-text { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--ink); letter-spacing: -0.01em; }
  @media (min-width: 420px) {
    .brand-text { font-size: 1.12rem; }
  }
  .brand-name { }

  .primary-nav { display: none; }
  .primary-nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .primary-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    padding: 0.4em 0;
    border-bottom: 1.5px solid transparent;
    white-space: nowrap;
  }
  .primary-nav a:hover { color: var(--ink); }
  .primary-nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--accent); }

  @media (min-width: 1140px) {
    .primary-nav { display: block; }
  }

  /* Plain glyphs, not a rack of bordered toolbar boxes. */
  .header-actions { display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
  }
  .icon-btn:hover { color: var(--ink); }

  /* 44px touch target regardless of the smaller visual glyph box. */
  .icon-btn::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  .lang-switch { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.03em; text-decoration: none; width: auto; padding: 0 0.5em; }

  /* Below 520px the row only fits the brand plus three controls, so the
     GitHub and language links move into the menu instead of overflowing. */
  .header-extra { display: none; }
  .mobile-nav-extra { display: block; }
  @media (min-width: 520px) {
    .header-extra { display: inline-flex; }
    .mobile-nav-extra { display: none; }
  }

  /* Declared after `.icon-btn` on purpose: same specificity, so source order
     decides, and the earlier copy of this rule lost to `display: inline-flex`. */
  @media (min-width: 1140px) {
    .nav-toggle { display: none; }
  }

  .mobile-nav { border-top: 1px solid var(--border); background: var(--bg); }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0.5rem 0; }
  .mobile-nav a {
    display: block;
    padding: 0.85rem 20px;
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav a[aria-current="page"] { color: var(--secondary); font-weight: 700; }
  @media (min-width: 1140px) {
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  // Remember the visitor's explicit language pick so the auto-redirect in
  // BaseLayout stops overriding it on later visits.
  document.querySelectorAll<HTMLAnchorElement>("a[data-lang-choice]").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("meshpr-lang", link.dataset.langChoice || "");
      } catch {}
    });
  });
</script>
