---
import MeshMark from "./MeshMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getLocaleFromPath, localizePath } from "../lib/i18n";
import { useStrings } from "../lib/ui-strings";
import { DISCORD_INVITE_URL, MESHCORE_PR_URL, PRMSH_HOME_URL } from "../lib/community";

const GITHUB_REPO_URL = "https://github.com/SirMelendezTech/WWW-PR-MSH";

interface Props { altLocaleHref?: string | null }
const { altLocaleHref = null } = Astro.props;

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const otherLocale = locale === "es" ? "en" : "es";
const t = useStrings(locale);

// Language switch target: explicit counterpart if given; otherwise the other
// locale's blog index for blog pages (post slugs don't mirror across locales),
// or a plain path swap everywhere else.
const isBlogPath = /^\/(en\/)?blog(\/|$)/.test(path);
const langSwitchHref = altLocaleHref
  ? altLocaleHref
  : isBlogPath
    ? localizePath("/blog/", otherLocale)
    : localizePath(path, otherLocale);
const homeHref = localizePath("/", locale);
// Named in its own language, like every other language picker.
const otherLocaleName = otherLocale === "es" ? "Español" : "English";

// `topBar: false` keeps a page out of the desktop bar only — the menu and the
// footer still list it. Seven items plus search and the Discord button is
// what fits the Spanish labels at the desktop breakpoint.
const navItemsBase = [
  { label: t.nav.gettingStarted, href: "/getting-started/" },
  { label: t.nav.hardware, href: "/hardware/" },
  { label: t.nav.settings, href: "/settings/" },
  { label: t.nav.howItWorks, href: "/how-it-works/", topBar: false },
  { label: t.nav.protocols, href: "/protocols/", topBar: false },
  { label: t.nav.prMesh, href: "/pr-mesh/" },
  { label: t.nav.map, href: "/map/" },
  { label: t.nav.blog, href: "/blog/" },
  { label: t.nav.community, href: "/community/" },
  { label: t.nav.links, href: "/links/", topBar: false },
];

// Every top-level page has an /en/ route, so localize all nav targets.
const navItems = navItemsBase.map((item) => ({
  label: item.label,
  href: localizePath(item.href, locale),
  topBar: item.topBar !== false,
}));
const topBarItems = navItems.filter((item) => item.topBar);

function isActive(href: string) {
  if (href === "/" || href === "/en/") return path === href;
  return path.startsWith(href);
}
---
<header class="site-header">
  {/* Family line: the same strip meshcore.prmsh.com carries, so a visitor can
      tell at a glance that this is one PRMSH site of several. It also holds
      language and theme, which stay reachable at every width. */}
  <div class="family-bar">
    <div class="container family-row">
      <nav class="family-crumbs" aria-label={t.nav.familyAria}>
        <a href={PRMSH_HOME_URL}>{t.nav.familyHome}</a>
        <span class="family-sep" aria-hidden="true">/</span>
        <a href={homeHref} class="is-current">Meshtastic</a>
      </nav>
      <div class="family-tools">
        <a href={MESHCORE_PR_URL} class="family-link family-sister" target="_blank" rel="noopener">
          {t.nav.sisterShort}<span class="sr-only"> {t.opensInNewTab}</span>
        </a>
        <a href={langSwitchHref} class="family-link" hreflang={otherLocale} lang={otherLocale} aria-label={otherLocale === "es" ? t.nav.switchToSpanish : t.nav.switchToEnglish}>
          {otherLocaleName}
        </a>
        <ThemeToggle lang={locale} />
      </div>
    </div>
  </div>

  <div class="container header-row">
    <a href={homeHref} class="brand">
      <MeshMark />
      <span class="brand-name">PRMSH</span>
    </a>

    <nav class="primary-nav" aria-label={t.nav.primaryNavAria}>
      <ul>
        {topBarItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button id="search-open" class="icon-btn search-open" type="button" aria-label={t.nav.searchAria} aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
      </button>
      <a href={DISCORD_INVITE_URL} class="btn btn-primary btn-sm header-cta" target="_blank" rel="noopener noreferrer">
        {t.nav.discordCta}
        <svg class="icon-ext" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2H2v8h8V7.5M7 2h3v3M10 2 5.5 6.5"/></svg>
        <span class="sr-only"> {t.opensInNewTab}</span>
      </a>
      <button
        id="nav-toggle"
        class="icon-btn nav-toggle"
        type="button"
        aria-label={t.nav.openMenuAria}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-label-open={t.nav.openMenuAria}
        data-label-close={t.nav.closeMenuAria}
      >
        <svg class="nav-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg class="nav-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.mobileNavAria} hidden>
    <ul class="container">
      {navItems.map((item) => (
        <li><a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <ul class="container mobile-nav-secondary">
      <li><a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer">{t.nav.discordCta}<span class="sr-only"> {t.opensInNewTab}</span></a></li>
      <li class="mobile-only-sister"><a href={MESHCORE_PR_URL} target="_blank" rel="noopener">{t.nav.sisterShort}<span class="sr-only"> {t.opensInNewTab}</span></a></li>
      <li><a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">{t.nav.viewSourceAria}<span class="sr-only"> {t.opensInNewTab}</span></a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* ---- Family line ---- */
  .family-bar { border-bottom: 1px solid var(--border); background: var(--bg-raised); }
  .family-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
  }
  .family-crumbs { display: flex; align-items: center; gap: 0.6ch; min-width: 0; white-space: nowrap; }
  .family-crumbs a { color: var(--ink-soft); text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .family-crumbs a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .family-crumbs a.is-current { color: var(--ink); text-decoration: none; }
  .family-sep { color: var(--ink-faint); }
  .family-tools { display: flex; align-items: center; gap: var(--s-4); }
  .family-link {
    position: relative;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .family-link:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  /* 44px-tall hit area inside a 36px strip. */
  .family-link::after { content: ""; position: absolute; inset: -0.75rem -0.4rem; }
  .family-sister { display: none; }
  @media (min-width: 560px) {
    .family-sister { display: inline; }
  }

  /* ---- Main bar ---- */
  .header-row {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .primary-nav { display: none; }
  .primary-nav ul { display: flex; align-items: center; gap: var(--s-1); list-style: none; margin: 0; padding: 0; }
  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-2);
    text-decoration: none;
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 500;
    white-space: nowrap;
    border-radius: var(--radius-md);
    transition: color 0.16s var(--ease-out);
  }
  .primary-nav a:hover { color: var(--ink); }
  /* Current page: ink plus a short red rule under the label, so "you are
     here" doesn't rely on colour alone. */
  .primary-nav a[aria-current="page"] { color: var(--ink); font-weight: 700; }
  .primary-nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: var(--s-2);
    right: var(--s-2);
    bottom: 6px;
    height: 2px;
    background: var(--accent);
  }

  @media (min-width: 1180px) {
    .primary-nav { display: block; }
  }

  .header-actions { display: flex; align-items: center; gap: var(--s-2); flex-shrink: 0; }
  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.16s var(--ease-out), background-color 0.16s var(--ease-out);
  }
  .icon-btn:hover { color: var(--ink); background: var(--bg-sunken); }
  .icon-btn::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  /* The open menu shows an X in the same spot, so the button that opened the
     menu is visibly the one that closes it. */
  .nav-icon-close { display: none; }
  .nav-toggle[aria-expanded="true"] { color: var(--ink); }
  .nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }

  .search-kbd { display: none; }
  @media (min-width: 1320px) and (hover: hover) {
    .search-open { width: auto; gap: 0.45rem; padding: 0 0.5rem; }
    .search-kbd {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1;
      padding: 0.3em 0.45em;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      color: var(--ink-faint);
      white-space: nowrap;
    }
    .search-open:hover .search-kbd { color: var(--ink-soft); }
  }

  /* Discord is the community's front door, so it gets the one filled button
     in the header — from tablet width up. On phones it moves into the menu. */
  .header-cta { display: none; }
  @media (min-width: 640px) {
    .header-cta { display: inline-flex; }
  }

  /* Declared after `.icon-btn` on purpose: same specificity, so source order
     decides. */
  @media (min-width: 1180px) {
    .nav-toggle { display: none; }
  }

  .mobile-nav { border-top: 1px solid var(--border); background: var(--bg); max-height: calc(100dvh - 6.5rem); overflow-y: auto; }
  .mobile-nav ul { list-style: none; margin-block: 0; padding-block: var(--s-2); }
  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav li:last-child a { border-bottom: none; }
  .mobile-nav a[aria-current="page"] { color: var(--ink); font-weight: 700; box-shadow: inset 3px 0 0 var(--accent); padding-left: var(--s-3); }
  .mobile-nav-secondary { border-top: 1px solid var(--border); font-size: var(--t-sm); }
  @media (min-width: 560px) {
    .mobile-only-sister { display: none; }
  }
  @media (min-width: 1180px) {
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const header = document.querySelector(".site-header");

  function setMenu(open: boolean, { restoreFocus = false } = {}) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
    if (label) toggle.setAttribute("aria-label", label);
    if (!open && restoreFocus) toggle.focus();
  }

  toggle?.addEventListener("click", () => setMenu(menu?.hidden ?? false));

  // Escape and a tap outside the header both close the menu, like any other
  // popover. Escape returns focus to the toggle so keyboard users are not lost.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) setMenu(false, { restoreFocus: true });
  });
  document.addEventListener("click", (e) => {
    if (!menu || menu.hidden) return;
    if (header && e.target instanceof Node && header.contains(e.target)) return;
    setMenu(false);
  });

  // On Mac the shortcut is Cmd, not Ctrl.
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll(".search-kbd").forEach((el) => { el.textContent = "⌘ K"; });
  }
</script>
