# Netlify / Cloudflare Pages redirect rules.
# Serve the English 404 page for unmatched /en/* routes. The root (Spanish)
# 404.html is served automatically for everything else. Inert on hosts that
# don't read this file (GitHub Pages included) — for Vercel, add the
# equivalent to vercel.json instead.
/en/*   /en/404/index.html   404
